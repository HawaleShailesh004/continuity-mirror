# Copy to .env.local. Server-only values: never prefix with NEXT_PUBLIC_.
# Validated by lib/server/env.ts (the app refuses to start on bad config).

YOUCAM_API_BASE=https://yce-api-01.makeupar.com
YOUCAM_API_KEY=
# live | mock | replay  (mock is the default; live spends units)
YOUCAM_MODE=mock
YOUCAM_WEBHOOK_SECRET=

SESSION_SECRET=
IP_HASH_SALT=

# memory | upstash
KV_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Share links (P1): private Vercel Blob. Without a token, an in-memory store is used (lost on restart).
BLOB_READ_WRITE_TOKEN=
ADMIN_TOKEN=
# Vercel Cron sends this as a Bearer token to /api/cron/cleanup (16+ chars). Required when CAP_SHARES=true on Vercel.
CRON_SECRET=

LIVE_GENERATION_ENABLED=true
UNIT_FLOOR=150
SESSION_UNIT_CAP=24
IP_DAILY_UNIT_CAP=48

CAP_BROWS=true
CAP_HEADWEAR=false
CAP_SCARF=false
CAP_REGROWTH=true
# Share links: leave unset locally (on by default off Vercel). On Vercel set true only with BLOB_READ_WRITE_TOKEN,
# CRON_SECRET and KV_DRIVER=upstash, or the app refuses to start.
CAP_SHARES=

PUBLIC_BASE_URL=

# Frontend: serve /api from MSW in the browser (dev only)
NEXT_PUBLIC_API_MOCKS=0

# Frontend: where /partners tells shops to write. Public by design (it is shown on the page). Empty = the page says details are coming.
NEXT_PUBLIC_PARTNER_EMAIL=
